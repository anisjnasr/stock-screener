# Massive (formerly Polygon.io) — get your API key at https://polygon.io
# Copy this file to .env.local and add your key:
# cp .env.example .env.local
MASSIVE_API_KEY=your_massive_api_key_here

# Supabase — profile sync (cross-device watchlists, scans, settings)
# Create a free project at https://supabase.com, then run data/supabase-schema.sql
# in the SQL Editor and copy the URL + anon key from Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: cron routes (economic calendar + market events). From Supabase Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for cron routes (may match ADMIN_SECRET if you use one secret on Render).
# Used by POST /api/cron/economic-calendar, POST /api/cron/market-events/*, POST /api/cron/fred-actuals, earnings crons,
# POST /api/cron/python-news (proxy to Python service), POST /api/cron/newsletter-ingest, POST /api/cron/macro-writeup.
CRON_SECRET=

# Anthropic — AI completion + Phase 4 macro writeup (POST /api/cron/macro-writeup)
# ANTHROPIC_API_KEY=

# Phase 4 — Gmail newsletter ingest + daily macro writeup (see docs/PHASE4-NEWSLETTER-OPERATOR.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Optional: comma-separated allowlist override (skips reading config/newsletters-for-writeups.txt)
# NEWSLETTER_ALLOWLIST=crew@morningbrew.com,doomberg@substack.com

# Phase 12A/B — Python microservice on Render (yfinance /news). PYTHON_SERVICE_KEY must match Python INTERNAL_API_KEY.
# PYTHON_SERVICE_URL=https://your-python-service.onrender.com
# PYTHON_SERVICE_KEY=

# Finnhub — earnings calendar (Phase 9). https://finnhub.io/register
# Used by POST /api/cron/earnings/ingest and POST /api/cron/earnings/actuals.
FINNHUB_API_KEY=

# FRED (Federal Reserve Economic Data) — free API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used by POST /api/cron/fred-actuals (Phase 2.5 backfill of economic_events.actual).
FRED_API_KEY=

# Optional: TradingView scanner cookies (server-only) for richer pre-market data on POST /api/movers/gappers.
# TRADINGVIEW_SESSIONID=
# TRADINGVIEW_SESSIONID_SIGN=

# Optional: admin bulk routes (existing)
# ADMIN_SECRET=
