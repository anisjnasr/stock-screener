# Massive (formerly Polygon.io) — get your API key at https://polygon.io
# Copy this file to .env.local and add your key:
# cp .env.example .env.local
MASSIVE_API_KEY=your_massive_api_key_here

# Supabase — profile sync (cross-device watchlists, scans, settings)
# Create a free project at https://supabase.com, then run data/supabase-schema.sql
# in the SQL Editor and copy the URL + anon key from Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: cron routes (economic calendar + market events). From Supabase Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for cron routes (may match ADMIN_SECRET if you use one secret on Render).
# Used by POST /api/cron/economic-calendar and POST /api/cron/market-events/*.
CRON_SECRET=

# Optional: admin bulk routes (existing)
# ADMIN_SECRET=
